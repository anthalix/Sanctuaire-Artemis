{% extends 'admin/admin.html.twig' %}
{% block title %}Tous les Clients!
{% endblock %}

{% block body %}


    <h1>Tous les Contacts</h1>


    <div class="container">


          <div class="list-group">
             {% for user in users %}
                 <div class="list-group-item">
                      <span>nom :</span> <p> <a href="{{path('messages', {'id' : user.id})}}">{{user.username | upper}}</a></p>
                      <span>email :</span> <p> {{user.email}}</p>
                      <span>tel :</span><p> {{user.tel}}</p>
                     <span>adresse :</span> <p> {{user.adresse}}</p>


                </div>
            {% endfor %}
        </div>
    </div>
    <style>
   

p{text-align:center;}

    </style>

{% endblock %}